# ---- Server ----
PORT=3000
# Where the JSON database is stored. On Render/Railway point this at a persistent disk, e.g. /var/data/db.json
DATA_FILE=./data/db.json

# ---- Company identity ----
COMPANY_NAME=Zenith Labs
# Mailbox that clients write to AND that the copilot sends client mails from
DELIVERY_EMAIL=delivery@yourcompany.com
TEAM_LEAD_NAME=Priya Nair
TEAM_LEAD_EMAIL=priya@yourcompany.com
ADMIN_EMAIL=admin@yourcompany.com

# ---- Outgoing mail (SMTP). Leave SMTP_HOST empty for dry-run mode: mails are only logged in the Outbox ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=delivery@yourcompany.com
# For Gmail / Google Workspace use an App Password, not your normal password
SMTP_PASS=
SMTP_FROM="Zenith Labs Delivery <delivery@yourcompany.com>"

# ---- Incoming mail (IMAP). Leave IMAP_HOST empty to disable the inbox poller ----
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=delivery@yourcompany.com
IMAP_PASS=
IMAP_POLL_SECONDS=60

# ---- AI planner (optional). Without a key the built-in rule-based planner is used ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
